{
  "name": "vaveva-luxury-ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "VAVEVA - Premium Luxury Fashion E-Commerce Platform",
  "scripts": {
    "install:all": "npm install",
    "seed": "npm run seed --workspace=backend",
    "server": "npm run dev --workspace=backend",
    "backend": "npm run dev --workspace=backend",
    "client": "npm run dev --workspace=frontend",
    "frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "npm run build --workspace=frontend"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "es-toolkit": "^1.50.0"
  }
}
